{
  "name": "vaultody-sdk-node",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "vaultody-sdk-node",
      "workspaces": [
        "packages/verify",
        "packages/sdk"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@vaultody-com/sdk": {
      "resolved": "packages/sdk",
      "link": true
    },
    "node_modules/@vaultody-com/verify": {
      "resolved": "packages/verify",
      "link": true
    },
    "packages/sdk": {
      "name": "@vaultody-com/sdk",
      "version": "0.9.0-rc.1",
      "license": "Apache-2.0",
      "dependencies": {
        "@vaultody-com/verify": "0.9.0-rc.1"
      },
      "bin": {
        "vaultody": "bin/vaultody.js"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "packages/verify": {
      "name": "@vaultody-com/verify",
      "version": "0.9.0-rc.1",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=22"
      }
    }
  }
}
